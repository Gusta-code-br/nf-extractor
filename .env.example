# Rename this file to .env and set your own keys

# ─── Banco de Dados ───────────────────────────────────────────
# String de conexão do Supabase (Transaction Pooler — porta 6543)
# Encontre em: Supabase Dashboard > Project Settings > Database > Connection string
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ─── Provedor de IA ───────────────────────────────────────────
# Opções: 'anthropic' | 'gemini' | 'huggingface' | 'openai'
AI_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.0-flash

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-SUA_CHAVE_AQUI

# Hugging Face
# HUGGINGFACE_API_KEY=hf_sua_chave_aqui
# HUGGINGFACE_MODEL=google/flan-t5-large

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ─── Servidor ────────────────────────────────────────────────
PORT=3000
